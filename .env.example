# ==============================================================================
# LLM Providers (Add keys for the providers you want to use)
# ==============================================================================
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_API_KEY="your-google-api-key"
GROQ_API_KEY="your-groq-api-key"

# If using Ollama locally, uncomment and set the URL
# OLLAMA_BASE_URL="http://localhost:11434"

# ==============================================================================
# Database Configuration
# ==============================================================================
# SQLite path for short-term memory (LangGraph checkpointer)
SQLITE_DB_PATH="./app/db/short-term-memory/stm.db"

# Postgres connection string for long-term memory (pgvector required)
# Format: postgresql://user:password@host:port/dbname
POSTGRES_URL="postgresql://chatbot:chatbot@localhost:5432/resume_chatbot"

# ==============================================================================
# JWT Authentication
# ==============================================================================
# Secret key used to sign JWT tokens. Keep this secure in production!
JWT_SECRET_KEY="super-secret-key-for-dev"

# ==============================================================================
# Vector Embeddings
# ==============================================================================
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIM="1536"

# ==============================================================================
# Agent Tools (Optional API Keys)
# ==============================================================================
# AlphaVantage API Key for the stock_tool
ALPHAVANTAGE_API_KEY="your-alphavantage-api-key"

# ==============================================================================
# LangSmith Tracing (Optional - for debugging and observability)
# ==============================================================================
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="your-langsmith-api-key"
# LANGCHAIN_PROJECT="resume-chatbot-longterm-memory"
